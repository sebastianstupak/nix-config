#!/usr/bin/env bash
#
# Repo commit-msg hook. Active via `core.hooksPath=.githooks` (set by the dev
# shell on NixOS, and once manually on other checkouts). Runs everywhere bash
# runs — Windows Git Bash and NixOS alike.
set -euo pipefail

msg_file="$1"

# This repo overrides the machine's global core.hooksPath, so the machine-wide
# policy in modules/home/git-hooks.nix never runs here — its two rules are
# mirrored below instead.
#
# The two copies are kept honest by the `git-hook-policy` flake check, which
# runs THIS file and the generated one against the same messages and fails if
# they disagree. Change one, change the other, or the check says so.
#
# Unlike the machine-wide version this only rejects; it never rewrites the
# message. A hook that edits what you wrote is surprising enough that it is
# worth having in exactly one place, and that place is the global one.
vendors='claude|anthropic|openai|chatgpt|copilot'
phrases='ai[ -]generated|generated by (an )?ai|written by (an )?ai|with ai assistance'

# 1. Attribution trailers.
if grep -qiE "^[[:space:]]*(co-authored-by:[[:space:]]*.*\b($vendors)|claude-session:[[:space:]]*|(🤖[[:space:]]*)?generated with[[:space:]]+.*\b($vendors))" "$msg_file"; then
  echo "AI attribution trailers are not allowed." >&2
  echo "Remove those lines before committing." >&2
  exit 1
fi

# 2. Any other mention, anywhere in the message.
#
#    Excluded from the check: git's own comment lines, which never reach the
#    commit, and anything shaped like a path or an identifier — a backtick span,
#    a slashed token, a dotted name, snake_case, camelCase. Naming a file is a
#    reference, not attribution, and without this the repo cannot describe its
#    own contents: "docs: update CLAUDE.md" and "rename claudeProfile" were both
#    rejected before this carve-out existed.
prose() {
  grep -v '^[[:space:]]*#' "$msg_file" \
    | sed -E -e 's/`[^`]*`/ /g' \
             -e 's#(^|[[:space:]])[^[:space:]]*/[^[:space:]]*#\1#g' \
             -e 's/(^|[[:space:]])[A-Za-z0-9_-]+\.[A-Za-z0-9_.-]+/\1/g' \
             -e 's/(^|[[:space:]])[A-Za-z0-9-]*_[A-Za-z0-9_-]*/\1/g' \
             -e 's/(^|[[:space:]])[a-z]+[A-Z][A-Za-z0-9]*/\1/g'
}

if prose | grep -qiE "\b($vendors)|$phrases"; then
  echo "Commit message names an AI vendor, or says it was AI-written." >&2
  echo "Describe the change itself, not the tool used to write it." >&2
  echo "Naming a file or an option is fine; it is prose that is rejected." >&2
  echo "To bypass once:  git commit --no-verify" >&2
  exit 1
fi

root="$(git rev-parse --show-toplevel)"
exec bash "$root/scripts/commit-msg.sh" "$msg_file"
