#!/usr/bin/env bash
#
# Delegates the pre-push flake check to lefthook (see lefthook.yml). Soft-skips
# when lefthook isn't on PATH. --no-auto-install keeps lefthook from rewriting
# these committed hooks.
set -euo pipefail

if command -v lefthook >/dev/null 2>&1; then
  exec lefthook run --no-auto-install pre-push "$@"
fi

echo "lefthook not found on PATH — skipping pre-push checks (enter the dev shell)."
exit 0
